{
  "name": "vrm-desktop-playground",
  "version": "0.1.0",
  "private": true,
  "description": "VRM 1.0 desktop character playground PoC for Electron on Ubuntu/Xwayland",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "predev": "npm run build:electron",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron --ozone-platform=x11 --no-sandbox . --dev\"",
    "prestart": "npm run build:electron",
    "start": "electron --ozone-platform=x11 --no-sandbox .",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "build:electron": "esbuild src/main/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/main.cjs && esbuild src/main/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.cjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.4.1",
    "@pixiv/three-vrm-animation": "^3.5.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "electron": "^44.2.0",
    "esbuild": "^0.25.5",
    "eslint": "^9.30.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.3"
  }
}
